{
  "name": "Odoo Academy (Codespaces)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "odoo",
  "workspaceFolder": "/workspace",
  "forwardPorts": [8069],
  "portsAttributes": {
    "8069": {
      "label": "Odoo",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "echo 'Ready: open the forwarded port 8069.'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-xml",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "files.eol": "\n",
        "python.defaultInterpreterPath": "/usr/bin/python3"
      }
    }
  }
}
